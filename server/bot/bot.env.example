# /etc/sato-bot/bot.env  (systemd EnvironmentFile, 0600, owned by sato-bot)
# Existing keys (unchanged) -----------------------------------------------
BOT_TOKEN=
CHANNEL_USERNAME=@sadaosato
ADMIN_IDS=
LEAD_API_URL=http://127.0.0.1:8081/api/lead
PAYMENT_URLS={"online_theory":"","offline_theory":"","practice_offline":"","full":""}
DB_PATH=/var/lib/sato-bot/bot.sqlite3
EVENT_DATE=
EARLY_BIRD_DEADLINE=
LEAD_TIMEOUT=12
SEND_RATE=25

# --- AI sales agent (BLOCKER: OPENAI_API_KEY) ----------------------------
# AI is live only when AI_ENABLED=1 AND OPENAI_API_KEY is set. Without a key
# the bot runs normally with the AI silently disabled.
OPENAI_API_KEY=
AI_ENABLED=1
# hybrid | autopilot | suggester  (launch in 'suggester' to de-risk, then hybrid)
AI_MODE=hybrid
AI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=700
AI_PAUSE_MINUTES=120
# Cost-DoS guards. Max model<->tool round-trips per turn, and a per-user request
# throttle (max AI turns per window seconds). Defaults are safe; tune if needed.
AI_MAX_TOOL_ROUNDS=4
AI_RATE_MAX_TURNS=6
AI_RATE_WINDOW_SEC=60
# Telegram chat/forum for suggester drafts + escalations (default: first ADMIN_ID).
MANAGER_CHAT_ID=
# Fact-injection for the AI prompt (empty -> falls back to content.py; never invents).
EVENT_DATES=
VENUE=
EXTRA_FACTS=

# --- amoJo two-way chat bridge (dormant until enabled) -------------------
# AMOJO_ENABLED=1 starts the loopback delivery server (8082) and lets the bot
# import client messages into amoCRM. Requires INTERNAL_TOKEN (same value as
# the backend amo.env). Leave AMOJO_ENABLED=0 to ship AI without amojo.
AMOJO_ENABLED=0
AMOJO_OUTBOUND_URL=http://127.0.0.1:8081/amojo/outbound
INTERNAL_LISTEN=127.0.0.1:8082
# Shared secret bot<->backend: openssl rand -hex 32  (identical in amo.env)
INTERNAL_TOKEN=
